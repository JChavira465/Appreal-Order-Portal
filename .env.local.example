NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_ — this bypasses RLS.
# Project Settings -> API -> "service_role" secret key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Optional -- only needed for the "AI concept" image feature
# on Order Detail. From platform.openai.com -> API keys. Leave unset and
# that feature just shows a "not set up yet" message; nothing else in the
# app depends on it.
OPENAI_API_KEY=your-openai-api-key

# Optional but recommended in production. The public base URL of this
# deployment (e.g. https://orders.yourdomain.com), used to build the
# magic-link callback URL. Without it that URL falls back to the incoming
# request's Origin header, which the requester controls.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- Billing (optional) ---
# Leave all of these unset and the app runs exactly as before: the Plan &
# Billing screen still shows the tiers but says checkout isn't switched
# on. Every company keeps whatever tier the platform admin set by hand.
#
# Stripe dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=sk_live_or_test_...
# Stripe dashboard -> Developers -> Webhooks -> your endpoint -> signing secret.
# The endpoint URL is https://your-domain/api/stripe/webhook and it needs
# these events: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...
# One recurring Price per tier per period, created in Stripe. Prices live
# in Stripe (not in code) so they can change without a deploy, and so
# existing subscribers keep the price they signed up at.
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_UNLIMITED_MONTHLY=price_...
STRIPE_PRICE_UNLIMITED_YEARLY=price_...

# --- Email notifications (optional) ---
# Without RESEND_API_KEY the app runs exactly as before and simply sends
# nothing. From resend.com -> API Keys.
RESEND_API_KEY=re_...
# Must be an address on a domain verified in Resend. Until a real domain
# is verified, leave unset and Resend's onboarding sender is used, which
# only delivers to your own account email — fine for testing, useless in
# production.
EMAIL_FROM=Order Desk <orders@your-domain.com>
